<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>org.example.celestelocalhost.runtimetest</ApplicationId>
    <ApplicationTitle>Celeste v10 Test</ApplicationTitle>
    <UseInterpreter>true</UseInterpreter>
    <TrimMode>copy</TrimMode>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game is supplied after publishing: retain its entire public FNA dependency. -->
    <TrimmerRootAssembly Include="FNA" RootMode="All" />
    <Reference Include="FNA">
      <HintPath>../deps/FNA.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../save-protection/SaveSnapshot.cs" Link="SaveSnapshot.cs" />
    <Compile Include="../save-protection/SavePolicy.cs" Link="SavePolicy.cs" />
    <Compile Include="../save-protection/SaveRestore.cs" Link="SaveRestore.cs" />
    <Compile Include="../save-protection/SaveCoordinator.cs" Link="SaveCoordinator.cs" />
  </ItemGroup>
</Project>
