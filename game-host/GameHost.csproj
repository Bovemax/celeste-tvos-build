<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-tvos</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>tvos-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>org.example.celestelocalhost</ApplicationId>
    <ApplicationTitle>Local FNA Game Host</ApplicationTitle>
    <UseInterpreter>true</UseInterpreter>
    <TrimMode>copy</TrimMode>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The game is supplied after publishing: retain its entire public FNA dependency. -->
    <TrimmerRootAssembly Include="FNA" RootMode="All" />
    <Reference Include="FNA">
      <HintPath>../deps/FNA.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
